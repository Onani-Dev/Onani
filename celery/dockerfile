# Container Image
# Use slim (glibc/Debian) when INSTALL_ML=true because tensorflow has no musl/Alpine wheels.
ARG INSTALL_ML=false
FROM python:3.10-slim AS base-true
FROM python:3.10-alpine AS base-false
FROM base-${INSTALL_ML}

ARG INSTALL_ML=false

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system deps (handles both Alpine and Debian)
RUN if command -v apk >/dev/null 2>&1; then \
        apk add --update --no-cache --virtual .tmp-build-deps gcc libc-dev \
        && apk add libffi-dev ffmpeg; \
    else \
        apt-get update && apt-get install -y --no-install-recommends \
            gcc libffi-dev ffmpeg \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# Unprivileged user the celery worker runs as (entrypoint chowns volumes,
# then drops to this user before exec'ing celery).
RUN if command -v apk >/dev/null 2>&1; then \
        addgroup -g 1000 app && adduser -D -u 1000 -G app app; \
    else \
        groupadd -g 1000 app && useradd -m -u 1000 -g app app; \
    fi

# Install requirements (optional ML extras controlled by build arg)
COPY requirements.txt requirements-ml.txt /
RUN pip3 install -r /requirements.txt \
    && if [ "$INSTALL_ML" = "true" ]; then pip3 install -r /requirements-ml.txt; fi

# Copy static folder
COPY ./frontend/public/static /static

# Copy working dir to root of virtual drive
COPY . /onani

RUN chmod +x /onani/celery/entrypoint.sh

RUN mkdir -p /images /avatars /logs \
    && chown -R app:app /onani /static /images /avatars /logs

# Set workdir
WORKDIR /onani

# Load entrypoint
ENTRYPOINT ["./celery/entrypoint.sh"]