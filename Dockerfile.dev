# Container Image
FROM python:3.10-slim

ARG INSTALL_ML=false
# Match the invoking host user so bind-mounted files stay writable/owned
# correctly on both sides. Override at build time if your host UID/GID isn't 1000.
ARG UID=1000
ARG GID=1000

# Environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Install build deps, FFmpeg, and PostgreSQL client tools for admin backup/restore
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev ffmpeg postgresql-client cron \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged user the dev server/worker run as. Root is still needed at
# container start (cron) — entrypoint.dev.sh drops to this user afterward.
RUN groupadd -g "$GID" app && useradd -m -u "$UID" -g app app

# Install requirements (optional ML extras controlled by build arg)
COPY requirements.txt requirements-ml.txt /
RUN pip3 install -r /requirements.txt \
    && if [ "$INSTALL_ML" = "true" ]; then pip3 install -r /requirements-ml.txt; fi

# Copy static folder
COPY ./frontend/public/static /static

# Copy working dir to root of virtual drive
COPY . /onani

# Set workdir
WORKDIR /onani

# Load entrypoint
ENTRYPOINT ["./entrypoints/entrypoint.dev.sh"]